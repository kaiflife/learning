{
  "name": "my-microfrontends-project",
  "private": true,
  "workspaces": [
    "host",
    "remote-app"
  ],
  "scripts": {
    "dev:host": "bun --filter host dev",
    "dev:remote": "bun --filter remote-app dev",
    "dev": "bun --filter \"*\" dev",
    "build": "bun --filter \"*\" build",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\""
  }
}
